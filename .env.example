# =============================================================================
# HEALIT - NATIONAL HEALTHCARE SAFETY PLATFORM
# =============================================================================

# =============================================================================
# SUPABASE CONFIGURATION
# =============================================================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# =============================================================================
# AI PROVIDER CONFIGURATION
# =============================================================================
# Choose: openai | anthropic | local
VITE_AI_PROVIDER=openai

# OpenAI Configuration
VITE_OPENAI_API_KEY=your-openai-api-key

# Anthropic Configuration
VITE_ANTHROPIC_API_KEY=your-anthropic-api-key

# Model versions per layer
VITE_EMERGENCY_MODEL=gpt-4-turbo
VITE_GUIDANCE_MODEL=gpt-4-turbo
VITE_COORDINATION_MODEL=gpt-4-turbo

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
VITE_APP_ENV=development
VITE_DEFAULT_LANGUAGE=he
VITE_LOG_LEVEL=debug

# Follow-through coordination settings
VITE_DEFAULT_REMINDER_DAYS=6
VITE_GAP_DETECTION_ENABLED=true
VITE_AUTO_APPROVE_ROUTINE=false

# =============================================================================
# EMERGENCY SERVICES (ISRAEL)
# =============================================================================
VITE_EMERGENCY_NUMBER=101
VITE_AMBULANCE_NUMBER=101
VITE_POLICE_NUMBER=100
VITE_FIRE_NUMBER=102

# =============================================================================
# SECURITY & AUDIT
# =============================================================================
VITE_AUDIT_ENABLED=true
VITE_AUDIT_RETENTION_DAYS=365
VITE_SESSION_TIMEOUT_MINUTES=60
VITE_MAX_LOGIN_ATTEMPTS=5

# =============================================================================
# FEATURE FLAGS (5 LAYERS)
# =============================================================================
VITE_ENABLE_EMERGENCY_LAYER=true
VITE_ENABLE_GUIDANCE_LAYER=true
VITE_ENABLE_COORDINATION_LAYER=true
VITE_ENABLE_DOCTOR_OVERSIGHT=true
VITE_ENABLE_LEARNING_LAYER=true

# =============================================================================
# KUPAT HOLIM INTEGRATION (FUTURE APIs)
# =============================================================================
# VITE_CLALIT_API_URL=
# VITE_MACCABI_API_URL=
# VITE_MEUHEDET_API_URL=
# VITE_LEUMIT_API_URL=
